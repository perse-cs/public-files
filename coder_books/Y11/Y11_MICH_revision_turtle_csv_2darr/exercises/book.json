      "id": "rev-tcd-c4",
      "name": "CSV 4 (hard): Validating orders",
      "guide": "c4_orders.md",
      "py": "c4_orders.py",
      "tests": [
        {
          "in": [],
          "out": [
            {
              "pattern": "Invalid order: 1003",
              "ignore": "wc"
            },
            {
              "pattern": "Invalid order: 1004",
              "ignore": "wc"
            },
            {
              "pattern": "Invalid order: 1007",
              "ignore": "wc"
            },
            {
              "pattern": "Invalid order: 1008",
              "ignore": "wc"
            },
            {
              "typ": "-",
              "pattern": "Invalid order: 100[12569]",
              "ignore": "wc"
            },
            {
              "pattern": "(^|\\n)Valid orders: 5"
            },
            {
              "pattern": "(^|\\n)Invalid orders: 4"
            },
            {
              "pattern": "Total value: £34\\.59"
            },
            {
              "typ": "f+",
              "filename": "valid_orders.csv",
              "pattern": "^1001,Pencil,12,0\\.35,4\\.20\\n1002,Ruler,3,1\\.20,3\\.60\\n1005,Glue stick,4,1\\.75,7\\.00\\n1006,Calculator,1,12\\.99,12\\.99\\n1009,Compass,2,3\\.40,6\\.80\\n?$"
            }
          ]
        },
        {
          "in": [],
          "out": [
            {
              "typ": "c+",
              "pattern": "def isValidOrder\\(",
              "ignore": "w"
            },
            {
              "typ": "c+",
              "pattern": "def calculateLineTotal\\(",
              "ignore": "w"
            },
            {
              "typ": "c+",
              "pattern": "def formatMoney\\(",
              "ignore": "w"
            },
            {
              "typ": "s+",
              "pattern": "^True$",
              "statement": "isValidOrder(['1', 'Pen', '3', '0.50'])"
            },
            {
              "typ": "s+",
              "pattern": "^False$",
              "statement": "isValidOrder(['1', 'Pen', 'three', '0.50'])"
            },
            {
              "typ": "s+",
              "pattern": "^False$",
              "statement": "isValidOrder(['1', 'Pen', '3'])"
            },
            {
              "typ": "s+",
              "pattern": "^False$",
              "statement": "isValidOrder(['1', '', '3', '0.50'])"
            },
            {
              "typ": "s+",
              "pattern": "^False$",
              "statement": "isValidOrder(['1', 'Pen', '0', '0.50'])"
            },
            {
              "typ": "s+",
              "pattern": "^False$",
              "statement": "isValidOrder(['1', 'Pen', '', '0.50'])"
            },
            {
              "typ": "s+",
              "pattern": "^3\\.60?$",
              "statement": "calculateLineTotal(3, 1.2)"
            },
            {
              "typ": "s+",
              "pattern": "^4\\.20?$",
              "statement": "calculateLineTotal(12, 0.35)"
            },
            {
              "typ": "s+",
              "pattern": "^£7\\.00$",
              "statement": "formatMoney(7)"
            },
            {
              "typ": "s+",
              "pattern": "^£12\\.50$",
              "statement": "formatMoney(12.5)"
            }
          ]
        }
      ],
      "additionalFiles": [
        {
          "filename": "orders.csv",
          "visible": true
        }
      ]
