              "typ": "s+",
              "pattern": "^4$",
              "statement": "countAdjacent([['*', '.', '*'], ['.', '.', '.'], ['*', '.', '*']], 1, 1)"
            },
            {
              "typ": "s+",
              "pattern": "^2$",
              "statement": "countAdjacent([['*', '.', '*'], ['.', '.', '.'], ['*', '.', '*']], 0, 1)"
            },
            {
              "typ": "s+",
              "pattern": "^0$",
              "statement": "countAdjacent([['*', '.', '*'], ['.', '.', '.'], ['*', '.', '*']], 2, 2)"
            },
            {
              "typ": "s+",
              "pattern": "^1$",
              "statement": "countAdjacent([['.', '.'], ['.', '*']], 0, 0)"
            },
            {
              "typ": "s+",
              "pattern": "^3$",
              "statement": "countAdjacent([['*', '*'], ['*', '*']], 0, 0)"
            },
            {
              "typ": "s+",
