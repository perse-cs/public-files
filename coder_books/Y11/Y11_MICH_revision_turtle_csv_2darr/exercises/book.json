              "pattern": "Invalid",
              "ignore": "c",
              "count": 1
            },
            {
              "pattern": "BOOM",
              "ignore": "c"
            },
            {
              "pattern": "Solution:\\n     0  1  2  3  4\n  0  1  \\*  2  1  1\n  1  2  2  2  \\*  1\n  2  \\*  2  3  3  2\n  3  1  2  \\*  \\*  1"
            }
          ]
        },
        {
          "in": [
            0,
            0
          ],
          "out": [
            {
              "typ": "c+",
              "pattern": "def countMines\\(",
              "ignore": "w"
            },
            {
              "typ": "c+",
              "pattern": "def countAdjacent\\(",
              "ignore": "w"
            },
            {
              "typ": "c+",
              "pattern": "def buildNumberGrid\\(",
              "ignore": "w"
            },
            {
              "typ": "c+",
              "pattern": "def displayGrid\\(",
              "ignore": "w"
