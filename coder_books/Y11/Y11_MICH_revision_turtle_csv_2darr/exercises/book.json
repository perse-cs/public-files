    {
      "id": "rev-tcd-t3",
      "name": "Turtle 3 (medium): Archery target",
      "guide": "t3_target.md",
      "py": "t3_target.py",
      "tests": [
        {
          "in": [
            3
          ],
          "out": [
            {
              "pattern": "Drawing a target with 3 rings",
              "ignore": "wc"
            },
            {
              "typ": "t",
              "pattern": "fill=\"#ff0000\" stroke=\"none\"",
              "count": 2
            },
            {
              "typ": "t",
              "pattern": "fill=\"#ffffff\" stroke=\"none\"",
              "count": 1
            },
            {
              "typ": "t",
              "pattern": "^(?:(?!stroke=\"none\")[\\s\\S])*<polygon points=\"300\\.0,390\\.0 [^\"]*\" fill=\"#ff0000\" stroke=\"none\"/>(?:(?!stroke=\"none\")[\\s\\S])*<polygon points=\"300\\.0,360\\.0 [^\"]*\" fill=\"#ffffff\" stroke=\"none\"/>(?:(?!stroke=\"none\")[\\s\\S])*<polygon points=\"300\\.0,330\\.0 [^\"]*\" fill=\"#ff0000\" stroke=\"none\"/>"
            }
          ]
        },
        {
          "in": [
            0,
            7,
            4
          ],
          "out": [
            {
              "pattern": "Invalid",
              "ignore": "c",
              "count": 2
            },
            {
              "pattern": "Drawing a target with 4 rings",
              "ignore": "wc"
            },
            {
              "typ": "t",
              "pattern": "fill=\"#ff0000\" stroke=\"none\"",
              "count": 2
            },
            {
              "typ": "t",
              "pattern": "fill=\"#ffffff\" stroke=\"none\"",
              "count": 2
            },
            {
              "typ": "t",
              "pattern": "^(?:(?!stroke=\"none\")[\\s\\S])*<polygon points=\"300\\.0,420\\.0 [^\"]*\" fill=\"#ff0000\" stroke=\"none\"/>(?:(?!stroke=\"none\")[\\s\\S])*<polygon points=\"300\\.0,390\\.0 [^\"]*\" fill=\"#ffffff\" stroke=\"none\"/>(?:(?!stroke=\"none\")[\\s\\S])*<polygon points=\"300\\.0,360\\.0 [^\"]*\" fill=\"#ff0000\" stroke=\"none\"/>(?:(?!stroke=\"none\")[\\s\\S])*<polygon points=\"300\\.0,330\\.0 [^\"]*\" fill=\"#ffffff\" stroke=\"none\"/>"
            }
          ]
        },
        {
          "in": [
            1
          ],
          "out": [
            {
              "pattern": "Drawing a target with 1 rings?",
              "ignore": "wc"
            },
            {
              "typ": "t",
              "pattern": "fill=\"#ff0000\" stroke=\"none\"",
              "count": 1
            },
            {
              "typ": "t",
              "pattern": "fill=\"#ffffff\" stroke=\"none\"",
              "count": 0
            },
            {
              "typ": "t",
              "pattern": "^(?:(?!stroke=\"none\")[\\s\\S])*<polygon points=\"300\\.0,330\\.0 [^\"]*\" fill=\"#ff0000\" stroke=\"none\"/>"
            }
          ]
        }
      ]
